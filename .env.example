# Google Sheets lead capture (service account, Sheets API v4).
# Create a service account in Google Cloud, enable the Google Sheets API, and
# share your sheet with the service account email as an Editor.
# Leave unset during development — leads are logged to the server console instead.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The PEM private key. On one line, keep the literal "\n" escapes and wrap in quotes.
GOOGLE_PRIVATE_KEY=
# The id from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
